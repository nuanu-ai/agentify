{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!.claude",
      "!apps/web",
      "!apps/scanner-worker",
      "!apps/browser-observer-actor",
      "!packages/scanner-contracts",
      "!packages/scanner-database",
      "!packages/scanner",
      "!packages/analytics",
      "!packages/observability",
      "!packages/remediation",
      "!ops",
      "!fixtures",
      "!tsconfig.scanner.json",
      "!vitest.scanner.config.ts",
      "!eslint.scanner.config.mjs",
      "!prettier.scanner.config.json",
      "!.prettierignore.scanner",
      "!.env.scanner.example",
      "!portal",
      "!spikes",
      "!apps/gateway/drizzle",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "formatWithErrors": false,
    "includes": [
      "**",
      "!packages/core/src/deployment/fixtures/test-channel.json",
      "!packages/core/src/deployment/fixtures/live-channel.json"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "complexity": {
        "preset": "recommended"
      },
      "correctness": {
        "preset": "recommended",
        "noUndeclaredDependencies": "error"
      },
      "performance": {
        "preset": "recommended"
      },
      "security": {
        "preset": "recommended"
      },
      "style": {
        "preset": "recommended",
        "noNonNullAssertion": "error",
        "useNodejsImportProtocol": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "error"
      },
      "nursery": {
        "preset": "none"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
