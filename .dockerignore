# What never belongs in a build context.
#
# node_modules first and for a reason: the install inside the image is done by
# pnpm from the lockfile, and a host's node_modules copied in would be both the
# largest thing in the context and the wrong platform's binaries.
node_modules
**/node_modules

.git
.github
.claude
.local
**/.local

# Build output, rebuilt inside the image.
apps/docs/.vitepress/dist
apps/docs/.vitepress/cache
**/dist

# A developer's own environment and editor leavings.
.env
.env.*
**/.env
**/.env.*
**/*.log
.DS_Store

# Scanner sources have their own Dockerfile-specific contexts. Keep them out
# of the commerce images that use this default repository context.
/apps/web
/apps/scanner-worker
/apps/browser-observer-actor
/packages/scanner-contracts
/packages/scanner-database
/packages/scanner
/packages/analytics
/packages/observability
/packages/remediation
/ops
/fixtures
/vitest.scanner.config.ts
/.env.scanner.example
/.actor
/.actorignore

# Private working material never belongs in an image context.
/06-design/reference
/research
/01-research
/02-meetings
