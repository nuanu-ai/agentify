# Runtime identity. Production must use the verified HTTPS origin.
APP_BASE_URL=http://localhost:3000
PRIVACY_EMAIL=privacy@agentify.ad
ABUSE_EMAIL=abuse@agentify.ad
LEGAL_OPERATOR=Operator identity pending confirmation
LEGAL_IDENTITY_CONFIRMED=false
# PostgreSQL connection string. The default is the stack's own server:
# `docker compose up -d --wait postgres` publishes it on 5432 and
# deploy/postgres-init/ makes the database on a volume that is new.
DATABASE_URL=postgresql://agentify_commerce:agentify_commerce@localhost:5432/agentify_scanner
# Operator UI may read through a connection of its own. Left empty it reuses DATABASE_URL.
DASHBOARD_DATABASE_URL=
# Dedicated destructive migration-test database; never point at shared/prod data.
MIGRATION_TEST_DATABASE_URL=postgresql://agentify_commerce:agentify_commerce@localhost:5432/agentify_scanner_migration_test
# Worker health server and stable instance identifier.
WORKER_HEALTH_PORT=8081
WORKER_ID=local-scanner-1
SCANNER_CONCURRENCY=10
# Analytics destinations must match ANALYTICS_ENV; preview/test cannot use production datasets.
ANALYTICS_ENV=local
POSTHOG_ENABLED=false
POSTHOG_DESTINATION_ENV=local
POSTHOG_HOST=http://127.0.0.1:8000
META_DESTINATION_ENV=local
META_GRAPH_BASE_URL=https://graph.facebook.com
META_API_VERSION=v23.0
# Feature flags. All external/paid surfaces default disabled locally.
CARD_SIGNAL_ENABLED=false
META_CAPI_ENABLED=false
PARTNER_POSTBACK_ENABLED=false
PUBLIC_SHARE_ENABLED=false
BENCHMARK_ENABLED=false
TURNSTILE_ENFORCED=false
SCANNER_CACHE_ENABLED=false
SCAN_ACCEPTANCE_ENABLED=true
# Passive Apify browser observation. Safe default is fully off: no rows/jobs/provider calls/UI.
APIFY_BROWSER_ENABLED=false
APIFY_BROWSER_MODE=off
APIFY_BROWSER_ACTOR_ID=prim_ghost/agentify-browser-observer
# Required immutable build number/tag when mode is shadow/report; never use floating latest in production.
APIFY_BROWSER_ACTOR_BUILD=
APIFY_BROWSER_SAMPLE_RATE=0.10
APIFY_BROWSER_CONCURRENCY=1
APIFY_BROWSER_TIMEOUT_SECONDS=60
APIFY_BROWSER_MAX_RUN_USD=0.05
APIFY_BROWSER_DAILY_BUDGET_USD=25
APIFY_BROWSER_MAX_PAGES=3
REMEDIATION_PROMPT_ENABLED=true
# Secret names only. Set values in the environment/hosting secret store.
TOKEN_HMAC_SECRET=
EMAIL_ENCRYPTION_KEY=
# Private cabinet endpoint and dedicated shared secret for report confirmation,
# recovery, cabinet handoff, and terminal identity deletion. Configure both or
# neither locally; production requires both. Never expose the secret publicly.
CABINET_IDENTITY_URL=
REPORT_IDENTITY_SECRET=
REGISTRATION_ENABLED=false
POSTHOG_API_KEY=
META_ACCESS_TOKEN=
META_DATASET_ID=
# Server-only partner registration postback key. Never expose as NEXT_PUBLIC or log it.
PARTNER_POSTBACK_SECRET=
ANALYTICS_RUNTIME_ENV=local
ANALYTICS_SERVER_DELIVERY_ENABLED=false
META_TEST_EVENT_CODE=
POSTHOG_BROWSER_KEY=
POSTHOG_BROWSER_HOST=
META_PIXEL_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ADAPTER=local
STRIPE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Production reverse-proxy authentication for /admin. Store only the Caddy password hash, never plaintext.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_HASH=
# Worker-only scoped Apify token. Never expose as NEXT_PUBLIC, Actor input, query parameter, log or evidence.
APIFY_API_TOKEN=
