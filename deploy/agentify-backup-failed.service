[Unit]
Description=Record in the journal that a backup unit failed

# The one place a failed backup or check is reported from, as one line under
# the tag agentify-backup. There is no alert yet (deploy/README.md, "Backups");
# when there is one, it is sent from here. systemd names the unit that failed
# in MONITOR_UNIT; should it not, the line names every backup unit.
[Service]
Type=oneshot
# Every $ the shell is to read is written $$, since systemd reads $ first.
ExecStart=/bin/sh -c 'unit="$${MONITOR_UNIT:-agentify-backup*}"; logger -t agentify-backup -p user.err "$$unit failed; journalctl -u $$unit says why, and deploy/README.md, Backups, says what to do."'
