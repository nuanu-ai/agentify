# Copy to a server-owned .env (0600), then replace every placeholder with a
# verified production value. Never import the test channel's data or secrets.
# Preserve existing live auth/payment/mail values unless rotation is
# intentional. There is no merchant key to seed: a deployed channel seeds none.
# This file is an inventory, not a runnable production config.
AGENTIFY_DB_PASSWORD=REPLACE_WITH_NEW_HEX_PASSWORD_AT_LEAST_24_CHARACTERS
AGENTIFY_SITE_ADDRESS=:8080
AGENTIFY_PUBLIC_ORIGIN=https://agentify.ad
AGENTIFY_COOKIE_SECURE=true
AGENTIFY_SURFACE_MODE=live
AGENTIFY_PAYMENT_NETWORK=eip155:8453
AGENTIFY_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=REPLACE_FROM_EXISTING_LIVE_CONFIG
CDP_API_KEY_SECRET=REPLACE_FROM_EXISTING_LIVE_CONFIG
AGENTIFY_AUTH_SECRET=REPLACE_FROM_EXISTING_LIVE_CONFIG
AGENTIFY_INVITATION=REPLACE_FROM_EXISTING_LIVE_CONFIG
GATEWAY_CABINET_SECRET=REPLACE_WITH_NEW_SECRET_FROM_openssl_rand_base64_32
MAIL_URL=REPLACE_FROM_EXISTING_LIVE_CONFIG
MAIL_API_KEY=REPLACE_FROM_EXISTING_LIVE_CONFIG
MAIL_FROM=REPLACE_FROM_EXISTING_LIVE_CONFIG
