# Copy to a server-owned .env (0600), then replace every placeholder with a
# verified production value. Never import the test channel's data or secrets.
# Preserve existing live merchant/auth/payment/mail values unless rotation is
# intentional. This file is an inventory, not a runnable production config.
AGENTIFY_DB_PASSWORD=REPLACE_WITH_NEW_HEX_PASSWORD_AT_LEAST_24_CHARACTERS
COINSLOT_SITE_ADDRESS=app.agentify.ad
COINSLOT_PUBLIC_ORIGIN=https://app.agentify.ad
COINSLOT_COOKIE_SECURE=true
COINSLOT_SURFACE_MODE=live
COINSLOT_PAYMENT_NETWORK=eip155:8453
COINSLOT_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=REPLACE_FROM_EXISTING_LIVE_CONFIG
CDP_API_KEY_SECRET=REPLACE_FROM_EXISTING_LIVE_CONFIG
COINSLOT_SEED_KEY=REPLACE_FROM_EXISTING_LIVE_CONFIG
COINSLOT_AUTH_SECRET=REPLACE_FROM_EXISTING_LIVE_CONFIG
COINSLOT_INVITATION=REPLACE_FROM_EXISTING_LIVE_CONFIG
MAIL_URL=REPLACE_FROM_EXISTING_LIVE_CONFIG
MAIL_API_KEY=REPLACE_FROM_EXISTING_LIVE_CONFIG
MAIL_FROM=REPLACE_FROM_EXISTING_LIVE_CONFIG
