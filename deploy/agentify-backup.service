[Unit]
Description=Back up this channel's databases and configuration to its restic repository
# Ordered after Docker, so a shutdown stops a backup before Docker. There is
# no Requires=: a unit whose dependency fails is not itself failed, and
# OnFailure= would miss it; without Docker the backup fails in its own words.
After=network-online.target docker.service
Wants=network-online.target
OnFailure=agentify-backup-failed.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agentify-backup
# A oneshot unit is not started again while it runs, so a run that outlasts
# ten minutes delays the next one rather than overlapping it. One that hangs,
# on a bucket that stops answering, fails here, and the failure is recorded.
TimeoutStartSec=30min
