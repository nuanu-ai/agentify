# What the shop's request log may hold. WooCommerce accepts an API key and its
# secret in the query string (consumer_key, consumer_secret, oauth_*) and in
# the Authorization header, and WooCommerce and WordPress put bearer values in
# links: an order's key and the buyer's email in a download link, a password
# reset key, a nonce, and the one-time token Agentify's Connect passes as
# user_id, which also travels inside redirect_to. A value nested in another
# parameter's value is caught only by the outer name. Every request header is dropped, and the value of any
# query parameter whose name mentions one of the words below, in any case, or
# carries a percent escape is replaced: PHP decodes an escaped name, so
# `%63onsumer_secret` reaches WooCommerce as consumer_secret. Caddy applies one
# filter per field, which is why this is a single expression.
(redacted_request) {
	request>uri regexp "(?i)([?&][^=&]*(?:%|consumer|oauth|key|order|email|nonce|token|pass|pwd|secret|auth|user|redirect|referer)[^=&]*)=[^&]*" "${1}=REDACTED"
	request>headers delete
}

{
	# Caddy's own messages, such as an upstream error, carry the request too.
	log default {
		format filter {
			wrap json
			fields {
				import redacted_request
			}
		}
	}
}

woo.nuanu.ai {
	encode zstd gzip
	reverse_proxy wordpress:80

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# The shop's request log: when, which method and path, the status, how
	# long it took and who said they were asking. The current file rolls at
	# 10 MiB; five rolled files are kept, each for at most thirty days.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				import redacted_request
				resp_headers delete
			}
		}
	}
	log_append user_agent {http.request.header.User-Agent}
}
