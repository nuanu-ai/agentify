# The single entry point. `/` is the scanner, `/docs` the portal, `/dashboard`
# the dashboard, and `/v0/*` and `/x402/*` the gateway (the merchant API and the
# storefront an agent buys at), so a merchant's engineer sees one origin and
# never reasons about ports. Every address the routes depend on is an
# environment variable with a local default; a deployment overrides the
# variable rather than editing a copy of this file.
#
#   AGENTIFY_SITE_ADDRESS      what Caddy listens on              :8080
#   AGENTIFY_FRONT_PAGE        required front-page route          no default
#   AGENTIFY_ASSET_ROOT        the shared browser assets          /srv/assets
#   AGENTIFY_PORTAL_ROOT       the portal's built output          /srv/docs
#   AGENTIFY_DASHBOARD_UPSTREAM  the dashboard's listener         app:3001
#   AGENTIFY_GATEWAY_UPSTREAM  the gateway's listener             app:3000
#   AGENTIFY_SCANNER_UPSTREAM  host:port of the scanner process   scanner:3000
#   AGENTIFY_SURFACE_MODE      what the static pages say           sandbox
#   AGENTIFY_PUBLIC_ORIGIN     the site's address the docs name    no default
#   ABUSE_EMAIL, LEGAL_OPERATOR, LEGAL_IDENTITY_CONFIRMED
#                              what the scanner's pages in the
#                              documentation say of its operator    no default
#
# The last four are given to this process with the values the scanner's own
# pages are given (compose.yaml), since the documentation names them too.
#
# The defaults are the service names on the compose network. Outside Docker,
# point the roots at the repository:
#
#   AGENTIFY_FRONT_PAGE=scanner_front_page \
#   AGENTIFY_ASSET_ROOT=packages/visual/public \
#   AGENTIFY_PORTAL_ROOT=apps/docs/dist/client \
#   AGENTIFY_DASHBOARD_UPSTREAM=127.0.0.1:3001 \
#   AGENTIFY_GATEWAY_UPSTREAM=127.0.0.1:3000 \
#   AGENTIFY_SCANNER_UPSTREAM=127.0.0.1:3000 \
#     caddy run --config deploy/Caddyfile
#
# The listen address defaults to a high port so it works unprivileged. A
# deployment sets AGENTIFY_SITE_ADDRESS to its hostname, which is what turns on
# Caddy's automatic HTTPS; do not disable it here.

# A direct test deployment receives TLS through an SNI pass-through ingress;
# port 80 stops at that ingress. TLS-ALPN therefore reaches this Caddy while
# HTTP-01 does not. The production inner Caddy listens on a bare private port,
# so this issuer block is inert there and the public edge owns certificates.
{
	# A failed upstream also logs a request through the runtime logger. Access
	# log filtering alone cannot protect a one-time link's query or cookies.
	log default {
		format filter {
			request>uri delete
			request>headers delete
			resp_headers delete
			wrap json
		}
	}
	# Only the challenge that can arrive here. Overridable, because a deployment
	# behind a different edge may reach port 80 after all.
	acme_ca {$AGENTIFY_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	cert_issuer acme {
		disable_http_challenge
	}
	# A second Caddy may terminate TLS before this one. Trust only that exact
	# peer for X-Forwarded-Proto and X-Forwarded-For; broad private ranges would
	# let another Docker service impersonate a browser's address.
	servers {
		trusted_proxies static {$AGENTIFY_TRUSTED_EDGE_CIDR:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# Every path the site block leaves unclaimed is the scanner's, `/admin`
# included: the scanner decides who may see the operator's pages and answers
# everybody else with its 404.
(scanner_front_page) {
	handle {
		reverse_proxy {$AGENTIFY_SCANNER_UPSTREAM:scanner:3000} {
			# One address for the browser, decided by the trusted-proxy boundary above;
			# values sent by any other peer are not evidence.
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# The marks and the font files the dashboard's pages and the documentation
# portal ask for by address (the scanner bundles its own). Named one by one: a
# broad /assets or /styles route would take those namespaces away from the
# scanner.
(shared_assets) {
	@shared_assets path /assets/agentify-mark.svg /assets/agentify-mark-heavy.svg /styles/fonts.css /styles/fonts/*.woff2
	handle @shared_assets {
		root * {$AGENTIFY_ASSET_ROOT:/srv/assets}
		file_server
	}
}

{$AGENTIFY_SITE_ADDRESS::8080} {
	encode zstd gzip

	# Same-origin is the whole boundary between the scanner, the portal, the
	# dashboard and the money path, so these headers matter.
	#
	# `Referrer-Policy: no-referrer` must not come back: with it, browsers send
	# `Origin: null` on every form POST, the dashboard's same-origin check refuses
	# them, and nobody can sign in. A command-line request does not reproduce it.
	#
	# HSTS and a Content-Security-Policy are deliberately absent: HSTS would pin
	# localhost in developers' browsers, and a CSP written without surveying the
	# portal's and dashboard's inline scripts either breaks pages or protects
	# nothing.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}

	# The mail-link form keeps its token out of Referer, including requests to
	# this origin. Unlike no-referrer, strict-origin preserves the Origin of a
	# native form POST, so the dashboard can keep rejecting cross-origin submits.
	@dashboard_link path /dashboard/sign-in/open

	import shared_assets

	# The gateway, at both prefixes of the contract's route table, with the path
	# passed through untouched. Dropping /x402 here would send every storefront
	# address to the scanner's 404 while every test stays green.
	#
	# The gateway must run with PUBLIC_BASE_URL set to this origin: it puts that
	# address into the payment challenge, and an agent sent to the process's own
	# port finds it closed.
	#
	# /healthz is public and outside /v0, which is the merchant's contract. It
	# reports the gateway alone and reveals nothing beyond `{"ok":true}`; it says
	# nothing about Postgres or the dashboard, which answers /dashboard/healthz
	# itself through the block below.
	@gateway path /v0 /v0/* /x402 /x402/* /healthz
	handle @gateway {
		reverse_proxy {$AGENTIFY_GATEWAY_UPSTREAM:app:3000}
	}

	# The dashboard. The prefix is passed through, not stripped, so the dashboard
	# builds its links from the path it was asked for. Two exact paths rather than
	# a /dashboard* glob, so a scanner page such as /dashboards-x is not captured.
	@dashboard path /dashboard /dashboard/*
	handle @dashboard {
		header @dashboard_link Referrer-Policy strict-origin
		reverse_proxy {$AGENTIFY_DASHBOARD_UPSTREAM:app:3001}
	}

	# Old links to /cabinet still arrive. 307 keeps a posted form's method and
	# body; a permanent 301 or 308 would be cached by browsers past a rollback.
	# It stays until the ad landing pages link to /dashboard/sign-in: their
	# buttons still open /cabinet/sign-in with the ad tracker's click
	# identifier in the query, which this redirect keeps.
	@cabinet_moved path_regexp cabinet_moved (?i)^/cabinet(/.*)?$
	handle @cabinet_moved {
		redir * /dashboard{re.cabinet_moved.1}{?query} 307
	}

	# The documentation. The prefix is stripped because the other side is a
	# directory: /docs/money must become money.html on disk, its data
	# money.data and its Markdown money.md. The documentation must therefore be
	# built knowing its mount point, or its assets and links point outside
	# /docs, which `pnpm --filter @agentify/docs build` does.
	#
	# Temporary redirect: browsers cache a 301 past the life of the mount point.
	redir /docs /docs/
	# The addresses the documentation answered at before, /docs/money.html,
	# lead to the page's own: /docs/index.html to the front page and
	# /docs/scanner/index.html to /docs/scanner.
	@docs_html path_regexp docs_html ^/docs/(.*?)/?(?:index)?\.html$
	redir @docs_html /docs/{re.docs_html.1}{?query} 308
	handle_path /docs/* {
		root * {$AGENTIFY_PORTAL_ROOT:/srv/docs}

		# A client that prefers Markdown to HTML gets the page's Markdown, as the
		# scanner answers its own pages: when the Accept header names
		# text/markdown with a quality above zero (the first expression) and does
		# not name text/html with one before it (the second). This differs from
		# the scanner's reading only where the two name different qualities in
		# the opposite order, such as `text/html;q=0.5, text/markdown`.
		@docs_markdown {
			header_regexp Accept `(?i)(?:^|,)\s*text/markdown\s*(?:$|,|;\s*q\s*=\s*(?:1|0*\.\d*[1-9]))`
			not header_regexp Accept `(?i)(?:^|,)\s*text/html\s*(?:,|;\s*q\s*=\s*(?:1|0*\.\d*[1-9])[^,]*,).*text/markdown`
			file {path}.md {path}index.md
		}
		handle @docs_markdown {
			rewrite * {file_match.relative}
			header Content-Type "text/markdown; charset=utf-8"
			header Cache-Control no-cache
			header Vary Accept
			templates {
				mime text/markdown
				between <!--{{ }}-->
			}
			file_server
		}
		# The same Markdown asked for by its own address.
		@docs_markdown_file path *.md
		handle @docs_markdown_file {
			header Content-Type "text/markdown; charset=utf-8"
			header Cache-Control no-cache
			templates {
				mime text/markdown
				between <!--{{ }}-->
			}
			file_server
		}
		handle {
			# Only a page with a prerendered HTML file has a canonical address;
			# missing paths keep their 404, and the documentation root keeps its slash.
			@docs_page_slash path_regexp docs_page_slash ^/(.+)/$
			route @docs_page_slash {
				@docs_page_exists {
					not path /index/ /404/
					file {re.docs_page_slash.1}.html
				}
				redir @docs_page_exists /docs/{re.docs_page_slash.1}{?query} 308
			}
			# The scripts and stylesheets carry a content hash in their names, so
			# a browser may keep them for a year; the build writes a brotli and a
			# gzip copy beside each, sent to a browser that accepts one.
			@docs_assets path /assets/*
			header @docs_assets Cache-Control "public, max-age=31536000, immutable"
			# A page's data, which the browser fetches to draw the page without a
			# reload, named as React Router names it, which also has encode
			# compress it as text. It and the search's index may be kept five
			# minutes, so a page fetched ahead once its link came into view is
			# drawn from that fetch when the link is followed; a browser left to
			# guess a lifetime from the file's age would keep it hours or not at
			# all.
			@docs_data path *.data
			header @docs_data Content-Type "text/x-script; charset=utf-8"
			@docs_kept path *.data /search-index.json
			header @docs_kept Cache-Control "public, max-age=300"
			# A page is asked again on every visit, so a release reaches a reader
			# at once, and it differs by the Accept header that chooses Markdown.
			@docs_pages not path /assets/* *.data *.json
			header @docs_pages Cache-Control no-cache
			header @docs_pages +Vary Accept

			try_files {path} {path}.html
			# AGENTIFY_SURFACE_MODE is set by hand rather than derived (Caddy cannot
			# read the chain identifier), so the release checks it against the
			# channel before anything starts and against the rendered pages
			# afterwards. Comment-shaped delimiters keep the files readable without
			# Caddy; `mime` keeps templating off stylesheets, scripts and data.
			templates {
				mime text/html
				between <!--{{ }}-->
			}
			file_server {
				precompressed br gzip
			}
		}
	}

	# The portal's own 404 page, status kept. It must be templated like any other
	# portal page, or a live deployment's 404 shows every mode's notice at once,
	# including "payments are pretend".
	handle_errors {
		@portal_missing `{err.status_code} == 404 && {http.request.orig_uri.path}.startsWith('/docs/')`
		handle @portal_missing {
			root * {$AGENTIFY_PORTAL_ROOT:/srv/docs}
			rewrite * /404.html
			templates {
				mime text/html
				between <!--{{ }}-->
			}
			file_server {
				status {err.status_code}
			}
		}
	}

	# No default: a stack that names no front page is refused at load rather than
	# answering a bare 404.
	import {$AGENTIFY_FRONT_PAGE}
}
