#!/usr/bin/env python3
"""The transition record of one channel: a release or a restore under way.

    deploy/transition <record> show               one line: from|to|restore|phase|cards|restoring
    deploy/transition <record> set key=value...   merges the pairs into the record, or starts it
    deploy/transition <record> clear              removes the record

deploy/activate.sh writes the record before it stops anything and advances its
phase: stopped, dumped (the restore point is whole and on disk), migrating,
started (written before the new release starts, which may then take writes).
It names the previous revision, the new one, the restore point and the file of
the cards on sale before the release. deploy/restore.sh sets `restoring` to
itself before it changes anything. The record goes when the release is
verified or a restore finishes; deploy/README.md, "When a release fails", says
what each state means to a person.

`show` prints an empty line when there is no record and fails on one it cannot
read, which is not the same as none. Every change is on disk before the
command returns: written beside the record, flushed, renamed over it, and the
directory flushed, so a power loss leaves the old record or the new one.
"""

import json
import os
import sys

FIELDS = ("from", "to", "restore", "phase", "cards", "restoring")

path, action, *pairs = sys.argv[1:]
record = None
if os.path.exists(path):
    with open(path) as existing:
        record = json.load(existing)
if action == "show":
    print("|".join(str((record or {}).get(field, "")) for field in FIELDS))
    sys.exit(0)
if action == "set":
    changes = dict(pair.split("=", 1) for pair in pairs)
    if not set(changes) <= set(FIELDS):
        sys.exit(f"transition: a record holds only {', '.join(FIELDS)}")
    with open(f"{path}.new", "w") as new:
        json.dump({**(record or {}), **changes}, new)
        new.flush()
        os.fsync(new.fileno())
    os.chmod(f"{path}.new", 0o644)
    os.replace(f"{path}.new", path)
elif action == "clear":
    if record is not None:
        os.remove(path)
else:
    sys.exit(f"transition: {action} is not show, set or clear")
directory = os.open(os.path.dirname(path), os.O_RDONLY)
os.fsync(directory)
os.close(directory)
