---
# Copy to deploy/ansible/inventory.local.yml and fill in with the real values.
# The copy is ignored by git and must stay that way: it names the machine the
# Woo acceptance route may be installed on, and that is an operator fact, not
# source.
#
#   ansible-playbook -i deploy/ansible/inventory.yml \
#     -e @deploy/ansible/inventory.local.yml deploy/ansible/woo-test-hairpin.yml ...
#
# Each value is either an address or a resolvable name; the user is the login
# on that machine. Leave nothing blank — a blank is not a default, it is a host
# you did not mean to touch.
agentify_test_host: REPLACE_WITH_TEST_ADDRESS_OR_NAME
agentify_test_user: REPLACE_WITH_TEST_LOGIN

# The short name the fixture host reports for `hostname -s`. The Woo hairpin
# refuses to run anywhere else.
woo_hairpin_expected_hostname: REPLACE_WITH_FIXTURE_SHORT_HOSTNAME

# The public hostnames and two addresses the TEST Woo hairpin translates
# between: the shared public address those names resolve to, and the ingress
# address on the far side of it.
woo_hairpin_public_hosts:
  - REPLACE_WITH_FIRST_PUBLIC_HOSTNAME
  - REPLACE_WITH_SECOND_PUBLIC_HOSTNAME
woo_hairpin_public_ip: REPLACE_WITH_SHARED_PUBLIC_ADDRESS
woo_hairpin_ingress_ip: REPLACE_WITH_INGRESS_ADDRESS
