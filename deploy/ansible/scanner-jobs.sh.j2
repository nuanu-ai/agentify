#!/usr/bin/env bash
set -euo pipefail

readonly release_sha="{{ release_sha }}"
readonly scanner_dir=/home/dmitry/agentify-commerce/ops/deploy/droplet
readonly scanner_env=/home/dmitry/agentify-scanner/.env.production
readonly backup_dir=/home/dmitry/agentify-backups/scanner

export AGENTIFY_SCANNER_WEB_IMAGE="agentify-scanner-web:$release_sha"
export AGENTIFY_SCANNER_WORKER_IMAGE="agentify-scanner-worker:$release_sha"
export AGENTIFY_SCANNER_PRIVACY_IMAGE="agentify-scanner-privacy:$release_sha"

cd "$scanner_dir"
case "${1:-}" in
  backup)
    install -d -m 700 "$backup_dir"
    docker compose --profile jobs --env-file "$scanner_env" \
      -f compose.production.yaml -f compose.hetzner.yaml \
      -f /home/dmitry/agentify-scanner/compose.scanner-handoff.yaml \
      run --rm --no-deps -T database-backup
    latest="$(find "$backup_dir" -type f -name 'agentify-*.dump' -print | sort | tail -1)"
    test -n "$latest"
    test -s "$latest"
    chmod 600 "$latest"
    ;;
  privacy)
    docker compose --profile jobs --env-file "$scanner_env" \
      -f compose.production.yaml -f compose.hetzner.yaml \
      -f /home/dmitry/agentify-scanner/compose.scanner-handoff.yaml \
      run --rm --no-deps -T privacy-cleanup
    ;;
  *)
    echo "Usage: scanner-jobs.sh backup|privacy" >&2
    exit 2
    ;;
esac
