[Unit]
Description=Agentify %i deployment pull agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/agentify-pull-agent/%i.json

[Service]
Type=oneshot
ExecStartPre=/usr/bin/systemctl is-active --quiet docker.service
ExecStart=/opt/agentify-pull-agent/current/venv/bin/python /opt/agentify-pull-agent/current/pull-agent.py --config /etc/agentify-pull-agent/%i.json
TimeoutStartSec=90min
UMask=0077

[Install]
WantedBy=multi-user.target
