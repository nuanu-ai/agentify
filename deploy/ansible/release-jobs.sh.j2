#!/usr/bin/env bash
set -euo pipefail
cd '{{ release_source_directory }}'
case "${1:-}" in
  privacy) service=scanner-privacy ;;
  *) echo 'Usage: scanner-jobs.sh privacy' >&2; exit 2 ;;
esac
exec flock -n /run/lock/agentify-scanner-jobs \
  docker compose --project-name '{{ channel.project }}' \
    --env-file '{{ release_directory }}/agentify.env' \
    -f compose.yaml -f deploy/compose.public.yaml -f '{{ channel.overlay }}' \
    -f '{{ release_controller_directory }}/release.yaml' \
    --profile jobs run --rm --no-deps -T "$service"
