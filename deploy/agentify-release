#!/usr/bin/env python3
"""Releases one revision on this host's channel.

    sudo agentify-release app-v1.2.3                 a tag, a branch, or on TEST a full SHA
    sudo agentify-release --restore <restore point>  puts both databases back as it holds them
    agentify-release --timer deploy-test             what TEST's timer runs once a minute

A person's run does not release or restore from the terminal. It hands the
work to a transient systemd unit, agentify-release-<channel>, and follows the
unit's journal until it ends, returning its exit status; a dropped connection
or Ctrl-C stops only the following. Inside a unit (that one, or the timer's) it
does the work itself. A restore runs deploy/restore.sh from the checkout of the
revision the transition record names, or else of `current`; nothing but a
person's `--restore` ever restores.

It resolves the name with `git ls-remote` against the public repository, finds
the revision's five images by the digests its image build published, fetches
the revision, and runs that revision's deploy/activate.sh with the images
pinned by those digests. It needs no GitHub credential and holds no host
credential for GitHub (ADR-0016). The channel and the repository come from
/etc/agentify/release.json, which deploy/install.sh writes.

The images are read by the rule in the header of .github/workflows/images.yml:
exactly one successful push run of the image build for the commit, that run's
`digests` job's check run, every page of its annotations counted against the
check run's count, and exactly one annotation titled `images`. A build still
running is a wait. PRODUCTION adds its conditions to that one path: the name
is an app-v* tag, the run is on main, main's CI run for the commit succeeded,
and the commit moves forward from the revision this host runs.

The state directory is /var/lib/agentify/<channel>, which activate.sh and
restore.sh read as well. It holds nothing secret, so it and its files can be
read by anyone on the host: `current`, the revision whose data the channel
holds, written by activate.sh before a verified release removes its record and
by a restore; `failed`, the last revision that was refused or failed; `seen`,
the revision the timer last began waiting for and when; `tags`, which app-v*
tag points at which revision, for messages; and the transition record
deploy/transition keeps.
A checkout is removed only after another revision is verified, when no record
names it. A person's run never skips anything and is how a release is retried.
Timer mode (TEST only) exits 0 without a word when the tag names `current` or
`failed`, or while the transition record waits for a person or cannot be
read. A wait (no build listed yet, a build still running, images that did not
arrive, a lock) exits 75, and the next tick asks again, until the timer has
waited 30 minutes for that revision in this boot; then the wait is recorded as
a failure.

Exit codes: 0 done, or in timer mode nothing to do; 75 a wait, nothing
changed; 1 a refusal; anything else is activate.sh's or restore.sh's own.
"""

import argparse
import contextlib
import fcntl
import http.client
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import time
import urllib.request


API = "https://api.github.com/repos/nuanu-ai/agentify"
IMAGES = ("app", "web", "scanner", "scanner-worker", "scanner-privacy")
FULL_SHA = re.compile(r"[0-9a-f]{40}")
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]*")
APP_TAG = re.compile(r"app-v[0-9A-Za-z._-]+")
PATIENCE = 30 * 60
STATES = Path("/var/lib/agentify")


class Refusal(Exception):
    """This revision must not run here."""


class Wait(Exception):
    """Not decidable yet, and nothing changed."""


def say(message):
    print(f"agentify-release: {message}", flush=True)


def fetch_json(url):
    request = urllib.request.Request(
        url, headers={"Accept": "application/vnd.github+json", "User-Agent": "agentify-release"}
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return json.load(response)
    except (OSError, ValueError, http.client.HTTPException) as error:
        raise Wait(f"GitHub did not answer {url} ({error})") from error


def field(document, name, kind):
    """document[name] when it is a `kind`; an empty list or dict, or None, when it is not."""
    value = document.get(name) if isinstance(document, dict) else None
    if isinstance(value, kind) and not isinstance(value, bool):
        return value
    return kind() if kind in (list, dict) else None


def git(*args, fails=Refusal, **options):
    """A git command's output. What reaches the network fails as a Wait; what is local, as a Refusal."""
    result = subprocess.run(["git", *map(str, args)], text=True, capture_output=True, **options)
    if result.returncode != 0:
        raise fails(f"git {' '.join(map(str, args[:3]))} failed: {(result.stderr or result.stdout).strip()}")
    return result.stdout.strip()


def resolve(repository, name, production):
    """The commit a name stands for, as the public repository says now; None if it names nothing."""
    if not NAME.fullmatch(name):
        raise Refusal(f"{name!r} is not a tag, branch or commit name")
    if production and not APP_TAG.fullmatch(name):
        raise Refusal(f"production releases an app-v* tag, and {name} is not one")
    refs = {}
    for line in git("ls-remote", repository, f"refs/tags/{name}", f"refs/tags/{name}^{{}}", f"refs/heads/{name}", fails=Wait).splitlines():
        sha, _, ref = line.partition("\t")
        refs[ref] = sha
    found = refs.get(f"refs/tags/{name}^{{}}") or refs.get(f"refs/tags/{name}")
    if found is None and not production:
        found = refs.get(f"refs/heads/{name}") or (name if FULL_SHA.fullmatch(name) else None)
    return found


def runs(revision, production, status=None):
    query = f"event=push&head_sha={revision}&per_page=100"
    query += "&branch=main" if production else ""
    query += f"&status={status}" if status else ""
    answer = fetch_json(f"{API}/actions/workflows/images.yml/runs?{query}")
    return [
        run
        for run in field(answer, "workflow_runs", list)
        if isinstance(run, dict)
        and run.get("head_sha") == revision
        and run.get("event") == "push"
        and (run.get("head_branch") == "main" or not production)
    ]


def image_digests(revision, production):
    """The five digests the commit's image build published, by the rule in images.yml's header."""
    built = runs(revision, production, status="success")
    if len(built) > 1:
        raise Refusal(f"GitHub lists {len(built)} successful image builds of {revision}, and the rule refuses rather than choose")
    if not built:
        listed = runs(revision, production)
        if any(run.get("status") != "completed" for run in listed):
            raise Wait(f"the images of {revision} are still being built")
        if listed:
            raise Refusal(f"the image build of {revision} did not succeed, so there are no images to pull")
        where = "the head of a push to main" if production else "the head of a pushed branch"
        raise Wait(
            f"GitHub lists no image build of {revision} yet; one starts when a commit is pushed as {where}, "
            "and a commit that never was one never gets one"
        )
    jobs = fetch_json(f"{API}/actions/runs/{built[0].get('id')}/jobs?per_page=100")
    named = [job for job in field(jobs, "jobs", list) if isinstance(job, dict) and job.get("name") == "digests"]
    check_run = str(named[0].get("check_run_url")) if len(named) == 1 else ""
    if not check_run.startswith(f"{API}/check-runs/"):
        raise Refusal(f"the image build of {revision} has no single digests job to read its images notice from")
    count = field(field(fetch_json(check_run), "output", dict), "annotations_count", int)
    if count is None:
        raise Refusal(f"the digests check run of {revision} does not say how many annotations it has")
    annotations, page = [], 1
    while True:
        batch = fetch_json(f"{check_run}/annotations?per_page=100&page={page}")
        if not isinstance(batch, list):
            raise Refusal(f"page {page} of the annotations of {revision}'s digests check run is not a list")
        annotations += batch
        if len(batch) < 100 or len(annotations) > count:
            break
        page += 1
    if len(annotations) != count:
        raise Refusal(
            f"the digests check run of {revision} holds {len(annotations)} annotations where its count "
            f"says {count}, so the images notice cannot be read whole"
        )
    notices = [note for note in annotations if isinstance(note, dict) and note.get("title") == "images"]
    if len(notices) != 1:
        raise Refusal(f"the digests check run of {revision} has {len(notices)} images notices where the rule wants exactly one")
    try:
        document = json.loads(notices[0].get("message") or "")
    except ValueError:
        document = None
    if not isinstance(document, dict) or sorted(document) != sorted(IMAGES) or not all(
        re.fullmatch(rf"ghcr\.io/nuanu-ai/agentify-{re.escape(name)}@sha256:[0-9a-f]{{64}}", str(document[name]))
        for name in IMAGES
    ):
        raise Refusal(f"the images notice of {revision} is not the five image digests")
    return {f"AGENTIFY_{name.upper().replace('-', '_')}_IMAGE": document[name] for name in IMAGES}


def require_ci(revision):
    answer = fetch_json(f"{API}/actions/workflows/ci.yml/runs?event=push&branch=main&head_sha={revision}&per_page=100")
    ci = [run for run in field(answer, "workflow_runs", list) if isinstance(run, dict) and run.get("head_sha") == revision]
    if not ci:
        raise Refusal(
            f"GitHub lists no CI run on main for {revision}, so nothing says it is fit to release; "
            "if it reached main moments ago, run this again once CI has started"
        )
    if ci[0].get("status") != "completed":
        raise Wait(f"main's CI run for {revision} has not finished")
    if ci[0].get("conclusion") != "success":
        raise Refusal(f"main's CI run for {revision} concluded {ci[0].get('conclusion')}")


def read(path):
    return path.read_text().strip() if path.exists() else None


def write(path, text):
    temporary = path.with_name(f".{path.name}")
    with temporary.open("w") as new:
        new.write(text + "\n")
        new.flush()
        os.fsync(new.fileno())
    temporary.chmod(0o644)
    os.replace(temporary, path)


def open_transition(state):
    """The transition record activate.sh and restore.sh keep, {} when there is none.
    One that cannot be read waits for a person, like an unfinished restore."""
    text = read(state / "transition")
    try:
        record = json.loads(text) if text is not None else {}
    except ValueError:
        record = None
    return record if isinstance(record, dict) else {"restoring": "the record cannot be read"}


def write_tags(config, state):
    """Which app-v* tag points at which revision, one `<revision> <tag>` a line,
    for the messages and the record activate.sh and restore.sh write."""
    tags = {}
    for line in git("ls-remote", "--tags", config["repository"], "refs/tags/app-v*", fails=Wait).splitlines():
        revision, _, ref = line.partition("\t")
        name = ref.removeprefix("refs/tags/")
        if name.endswith("^{}"):
            tags[name[:-3]] = revision
        else:
            tags.setdefault(name, revision)
    write(state / "tags", "\n".join(f"{revision} {name}" for name, revision in sorted(tags.items())))


def channel_state(config):
    state = STATES / config["channel"]
    # Nothing here is secret (revision names, checkouts of the public
    # repository, public digests), so a person on the host can read it.
    state.mkdir(parents=True, exist_ok=True)
    for directory in (state.parent, state):
        directory.chmod(0o755)
    return state


@contextlib.contextmanager
def command_lock(state):
    with (state / "release.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Wait("another agentify-release holds this host's lock")
        yield


def booted():
    """When this host booted, as its monotonic clock counts."""
    return int(time.time() - time.monotonic())


def first_seen(state, revision):
    """When the timer began waiting for this revision, in this boot: a host that
    was down does not spend the patience of what it waited for before."""
    seen = (read(state / "seen") or "").split()
    if len(seen) == 2 and seen[0] == revision and seen[1].isdigit():
        return max(int(seen[1]), booted())
    now = int(time.time())
    write(state / "seen", f"{revision} {now}")
    return now


def activate(config, state, name, revision, mirror):
    production = config["channel"] == "production"
    images = image_digests(revision, production)
    running = read(state / "current") if production else None
    git("-C", mirror, "fetch", "-q", "--no-tags", config["repository"], revision, *filter(None, [running]), fails=Wait)
    if production:
        require_ci(revision)
        if running and subprocess.run(["git", "-C", str(mirror), "merge-base", "--is-ancestor", running, revision]).returncode:
            raise Refusal(f"{revision} does not move forward from {running}, which this host runs")
    path = state / "checkouts" / revision
    if not path.exists():
        path.parent.mkdir(exist_ok=True)
        git("-C", mirror, "worktree", "prune")
        # The postgres image reads its init scripts from this tree as its own
        # user, so the files are readable by everyone, whatever the umask.
        git("-C", mirror, "worktree", "add", "--detach", path, revision, preexec_fn=lambda: os.umask(0o022))
    if git("-C", path, "rev-parse", "HEAD") != revision or git("-C", path, "status", "--porcelain"):
        raise Refusal(f"{path} is not a clean checkout of {revision}")
    if not (path / "deploy" / "activate.sh").is_file():
        raise Refusal(f"{revision} has no deploy/activate.sh, so it predates this way of releasing")
    write_tags(config, state)
    say(f"activating {name} ({revision}) on {config['channel']}")
    return subprocess.run(
        [str(path / "deploy" / "activate.sh"), config["channel"], revision], cwd=path, env={**os.environ, **images}
    ).returncode


def release(config, name, timer):
    if timer and config["channel"] != "test":
        raise Refusal("only TEST releases by timer; a person releases production")
    state = channel_state(config)
    with command_lock(state):
        revision = resolve(config["repository"], name, config["channel"] == "production")
        if revision is None:
            if timer:
                return 0
            raise Refusal(f"{name} names nothing in the repository")
        if timer and revision in (read(state / "current"), read(state / "failed")):
            return 0
        # Another revision's transition that had not started, an unfinished
        # restore or a record that cannot be read waits for a person
        # (activate.sh), so the timer leaves this revision alone rather than
        # recording it as failed.
        record = open_transition(state)
        if timer and (record.get("restoring") or (record.get("to") != revision and record.get("phase") not in (None, "started"))):
            return 0
        since = first_seen(state, revision) if timer else None
        mirror = state / "repository.git"
        if not mirror.exists():
            git("init", "-q", "--bare", mirror)
        try:
            code = activate(config, state, name, revision, mirror)
            if code == 75:
                raise Wait("activation had to wait, for the reason in its line above")
        except Wait as wait:
            if since is None or time.time() - since < PATIENCE:
                raise
            write(state / "failed", revision)
            raise Refusal(f"{revision} has waited {PATIENCE // 60} minutes: {wait}") from wait
        except Refusal:
            write(state / "failed", revision)
            raise
        if code != 0:
            write(state / "failed", revision)
            say(f"{revision} failed; fix the cause and run agentify-release {name} again")
            return code
        write(state / "current", revision)
        if read(state / "failed") == revision:
            (state / "failed").unlink()
        for other in (state / "checkouts").iterdir():
            if other.name != revision:
                subprocess.run(["git", "-C", str(mirror), "worktree", "remove", "--force", str(other)], capture_output=True)
        subprocess.run(["git", "-C", str(mirror), "worktree", "prune"], capture_output=True)
        say(f"{config['channel']} runs {revision}, verified")
        return 0


def restore(config, directory):
    """Runs restore.sh for a person, inside the unit, from the checkout of the
    revision the transition record names, or else of `current`."""
    state = channel_state(config)
    with command_lock(state):
        revision = open_transition(state).get("to") or read(state / "current") or ""
        script = state / "checkouts" / revision / "deploy" / "restore.sh"
        if not revision or not script.is_file():
            raise Refusal(f"no checkout on this host names a restore.sh for {revision or 'a channel no release has verified'}")
        write_tags(config, state)
        code = subprocess.run([str(script), directory]).returncode
        if code == 75:
            raise Wait("the restore had to wait, for the reason in its line above")
        return code


def read_config(path):
    config = json.loads(Path(path).read_text())
    if not isinstance(config, dict) or set(config) != {"channel", "repository"}:
        raise ValueError(f"{path} names exactly channel and repository")
    if config["channel"] not in ("test", "production"):
        raise ValueError(f"in {path} the channel is test or production")
    return config


def launch(config, argv):
    """Hands a person's release or restore to a transient unit and follows its journal until it ends."""
    unit = f"agentify-release-{config['channel']}.service"
    if os.geteuid() != 0:
        raise Refusal(f"agentify-release runs as root: sudo agentify-release {' '.join(argv)}")
    if subprocess.run(["systemctl", "is-active", "--quiet", unit]).returncode == 0:
        raise Wait(f"a release or restore is already running as {unit}; journalctl -u {unit} -f follows it")
    since = f"@{int(time.time())}"
    say(f"it runs as {unit}: a lost connection does not stop it, and journalctl -u {unit} holds its whole log")
    unit_run = subprocess.Popen(
        ["systemd-run", f"--unit={unit}", "--wait", "--collect", "--quiet",
         # What agentify-release.service holds for the timer: after Docker,
         # so a shutdown stops the release and its restore before Docker;
         # the same last resort and time to restore; readable state.
         "--property=After=network-online.target docker.service", "--property=Wants=network-online.target",
         "--property=Requires=docker.service", "--property=UMask=0022",
         "--property=RuntimeMaxSec=2h", "--property=TimeoutStopSec=30min",
         sys.executable, str(Path(__file__).resolve()), *argv],
        start_new_session=True,
    )
    with tempfile.NamedTemporaryFile() as cursor:
        def follow():
            subprocess.run(["journalctl", f"_SYSTEMD_UNIT={unit}", f"--since={since}", "--output=cat",
                            "--no-pager", f"--cursor-file={cursor.name}"])
        try:
            while unit_run.poll() is None:
                follow()
                time.sleep(1)
            time.sleep(1)
            follow()
        except KeyboardInterrupt:
            say(f"stopped following; it goes on as {unit}, and journalctl -u {unit} -f follows it")
            return 130
    return unit_run.returncode


def main(argv=None):
    parser = argparse.ArgumentParser(description="Release one revision on this host's channel, or restore a restore point")
    parser.add_argument("name", nargs="?", help="an app-v* tag on production; a tag, branch or full SHA on test")
    parser.add_argument("--timer", action="store_true", help="skip what is current or failed, and wait quietly")
    parser.add_argument("--restore", metavar="DIRECTORY", help="restore both databases from this restore point")
    parser.add_argument("--config", type=Path, default=Path("/etc/agentify/release.json"))
    arguments = parser.parse_args(argv)
    if (arguments.name is None) == (arguments.restore is None) or (arguments.timer and arguments.restore):
        parser.error("name one revision to release, or --restore one restore point")
    try:
        config = read_config(arguments.config)
        if not arguments.timer and "INVOCATION_ID" not in os.environ:
            return launch(config, sys.argv[1:] if argv is None else argv)
        # Inside a unit a stop request reaches activate.sh or restore.sh, which
        # end as they must; this process waits for that and records the result.
        signal.signal(signal.SIGTERM, lambda signum, frame: None)
        if arguments.restore:
            return restore(config, arguments.restore)
        return release(config, arguments.name, arguments.timer)
    except Wait as wait:
        say(f"{wait}; nothing changed" + ("; the next tick asks again" if arguments.timer else ", run this again later"))
        return 75
    except Refusal as refusal:
        say(f"refused: {refusal}")
        return 1
    except PermissionError as error:
        say(f"agentify-release runs as root: sudo agentify-release {arguments.name or '--restore ' + arguments.restore} ({error})")
        return 1
    except (OSError, ValueError) as error:
        say(f"refused its own configuration or state: {error}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
