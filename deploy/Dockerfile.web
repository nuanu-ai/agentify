# The entry point: Caddy, with everything static it serves inside it, the
# portal included, so the compose file does not make a host build the
# documentation first.
#
# The portal must be built with `--base /docs/`, or every page asks for
# /assets/... at the root of the origin, where the scanner answers. The mount
# point is a build argument rather than part of the portal's config because it
# is the route table's business.

FROM node:24.21.0-alpine AS portal
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/docs/package.json apps/docs/package.json
RUN pnpm install --frozen-lockfile --filter @agentify/docs...

COPY apps/docs apps/docs
RUN pnpm --filter @agentify/docs exec vitepress build --base /docs/

FROM caddy:2.10.0-alpine@sha256:ae4458638da8e1a91aafffb231c5f8778e964bca650c8a8cb23a7e8ac557aa3c

COPY deploy/Caddyfile /etc/caddy/Caddyfile
# The mark and the font files the dashboard's pages ask for, at the addresses
# the route table names.
COPY packages/visual/public /srv/assets
COPY --from=portal /app/apps/docs/.vitepress/dist /srv/docs
