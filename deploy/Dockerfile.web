# The entry point: Caddy, with everything static it serves inside it, the
# documentation included, so the compose file does not make a host build the
# documentation first.
#
# The documentation is built from the workspace, since its pages draw the
# shared header and the shared stylesheets, as the application's image
# installs it: the dependencies off the lockfile alone first, so that layer
# survives every edit to the source. Its diagrams are drawn already and kept
# beside the Markdown, so the build runs no browser. Vite's manifest, which
# only the speed budget reads, is not served.

FROM node:24.21.0-alpine AS docs
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
WORKDIR /app

COPY pnpm-lock.yaml ./
RUN pnpm fetch

COPY . .
RUN pnpm install --frozen-lockfile --offline --filter "@agentify/docs..."
RUN pnpm --filter @agentify/docs build && rm -rf apps/docs/dist/client/.vite

FROM caddy:2.10.0-alpine@sha256:ae4458638da8e1a91aafffb231c5f8778e964bca650c8a8cb23a7e8ac557aa3c

COPY deploy/Caddyfile /etc/caddy/Caddyfile
# The marks and the font files the dashboard's pages and the documentation
# ask for, at the addresses the route table names.
COPY packages/visual/public /srv/assets
COPY --from=docs /app/apps/docs/dist/client /srv/docs
