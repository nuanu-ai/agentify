# The one door: Caddy, with everything static it serves already inside it.
#
# ADR-0005 §1 puts the scanner, the portal, the cabinet and the gateway on one
# origin. One of those four is a directory of files rather than a process, and
# this image is where it comes from — so the image can be run on its own and
# the compose file does not have to make a host build the documentation first.
#
# The portal is built here, and with the mount point passed in: built without
# `--base /docs/` every page asks for /assets/... at the root of the origin,
# where the scanner answers and has nothing by that name. The flag is a build
# argument and not an edit to apps/docs/.vitepress/config.mjs on purpose — where
# the documentation is mounted is this directory's business, and the portal
# should not carry the answer in a file of its own (deploy/Caddyfile).

FROM node:24.21.0-alpine AS portal
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/docs/package.json apps/docs/package.json
RUN pnpm install --frozen-lockfile --filter @agentify/docs...

COPY apps/docs apps/docs
RUN pnpm --filter @agentify/docs exec vitepress build --base /docs/

FROM caddy:2.10.0-alpine@sha256:ae4458638da8e1a91aafffb231c5f8778e964bca650c8a8cb23a7e8ac557aa3c

COPY deploy/Caddyfile /etc/caddy/Caddyfile
# The mark and the faces the cabinet's pages ask for. They live in the visual
# package with the stylesheet they belong to; this image is what puts them at
# the addresses the route table names.
COPY packages/visual/public /srv/assets
COPY --from=portal /app/apps/docs/.vitepress/dist /srv/docs
