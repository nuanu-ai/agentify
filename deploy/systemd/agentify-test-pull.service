[Unit]
Description=Pull an exact green Agentify main revision into the test channel
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=dmitry
Group=dmitry
SupplementaryGroups=docker
ExecStart=/home/dmitry/.local/libexec/agentify-pull-agent /home/dmitry/.local/libexec/agentify-release /var/lib/agentify/test-pull.state /home/dmitry/agentify-test/.agentify-revision
StateDirectory=agentify
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dmitry/.cache /home/dmitry/agentify-test -/home/dmitry/.docker
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=30min
