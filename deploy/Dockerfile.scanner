FROM node:24.22.1-alpine AS base

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY packages/scanner-contracts/package.json packages/scanner-contracts/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/scanner-database/package.json packages/scanner-database/package.json
COPY packages/analytics/package.json packages/analytics/package.json
COPY packages/consent/package.json packages/consent/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/scanner/package.json packages/scanner/package.json
COPY packages/remediation/package.json packages/remediation/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/visual/package.json packages/visual/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @agentify/web...

FROM dependencies AS builder

ENV NODE_ENV=production

COPY packages/scanner-contracts packages/scanner-contracts
COPY packages/contracts packages/contracts
COPY packages/scanner-database packages/scanner-database
COPY packages/analytics packages/analytics
COPY packages/consent packages/consent
COPY packages/observability packages/observability
COPY packages/scanner packages/scanner
COPY packages/remediation packages/remediation
COPY packages/ui packages/ui
COPY packages/visual packages/visual
COPY apps/web apps/web
RUN pnpm --filter @agentify/web build

FROM builder AS privacy-jobs

ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@agentify/web", "privacy:cleanup"]

# The build is the whole process, every package it imports bundled in
# (apps/web/vite.config.ts), so the image carries the build and nothing
# installed beside it.
FROM node:24.22.1-alpine AS runner

ARG AGENTIFY_SOURCE_REVISION=unknown
ENV AGENTIFY_SOURCE_REVISION=$AGENTIFY_SOURCE_REVISION

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /app
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs scanner

COPY --from=builder --chown=scanner:nodejs /app/apps/web/package.json /app/apps/web/server.js ./
COPY --from=builder --chown=scanner:nodejs /app/apps/web/dist ./dist
COPY deploy/scanner-entrypoint.sh /usr/local/bin/scanner-entrypoint.sh

USER scanner
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/bin/sh", "/usr/local/bin/scanner-entrypoint.sh"]
CMD ["node", "server.js"]
