{
  "name": "@agentify/scanner-database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts",
    "test": "vitest run --config ../../vitest.scanner.config.ts --exclude src/migrations.integration.test.ts",
    "test:unit": "vitest run --config ../../vitest.scanner.config.ts --exclude src/migrations.integration.test.ts",
    "test:migrations": "vitest run --config ../../vitest.scanner.config.ts src/migrations.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentify/analytics": "workspace:*",
    "@agentify/scanner-contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vite": "7.3.6"
  }
}
