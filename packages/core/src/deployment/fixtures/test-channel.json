{
  "name": "agentify-test",
  "networks": {
    "default": {
      "name": "agentify-test_default",
      "ipam": {}
    }
  },
  "services": {
    "cabinet": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.app"
      },
      "command": [
        "pnpm",
        "--filter",
        "@agentify/commerce-cabinet",
        "start"
      ],
      "depends_on": {
        "gateway": {
          "condition": "service_started",
          "required": true
        },
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_SECRET": "fixture-auth-secret",
        "BASE_PATH": "/cabinet",
        "COOKIE_SECURE": "true",
        "DATABASE_URL": "postgres://agentify_commerce:agentify_commerce@postgres:5432/agentify_commerce",
        "FACILITATOR_URL": "https://x402.org/facilitator",
        "GATEWAY_URL": "http://gateway:3000",
        "MAIL_API_KEY": "",
        "MAIL_FROM": "Agentify <no-reply@localhost>",
        "MAIL_URL": "sandbox:log",
        "PAYMENT_NETWORK": "eip155:84532",
        "PORT": "3001",
        "PUBLIC_BASE_URL": "https://test.agentify.ad"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3001/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 15,
        "start_period": "15s"
      },
      "image": "agentify-test-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "gateway": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.app"
      },
      "command": [
        "pnpm",
        "--filter",
        "@agentify/commerce-gateway",
        "start"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "CDP_API_KEY_ID": "",
        "CDP_API_KEY_SECRET": "",
        "DATABASE_URL": "postgres://agentify_commerce:agentify_commerce@postgres:5432/agentify_commerce",
        "FACILITATOR_URL": "https://x402.org/facilitator",
        "PAYMENT_NETWORK": "eip155:84532",
        "PAY_TO_ADDRESS": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
        "PORT": "3000",
        "PUBLIC_BASE_URL": "https://test.agentify.ad",
        "REGISTRATION_INVITATION": "fixture-invitation",
        "SANDBOX_MERCHANT_KEY": "csk_test_fixture-deployment-key"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 15,
        "start_period": "15s"
      },
      "image": "agentify-test-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "migrate": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.app"
      },
      "command": [
        "pnpm",
        "db:migrate"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "postgres://agentify_commerce:agentify_commerce@postgres:5432/agentify_commerce"
      },
      "image": "agentify-test-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "postgres": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "agentify_commerce",
        "POSTGRES_PASSWORD": "agentify_commerce",
        "POSTGRES_USER": "agentify_commerce"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U agentify_commerce -d agentify_commerce"
        ],
        "timeout": "3s",
        "interval": "2s",
        "retries": 15
      },
      "image": "postgres:17-alpine",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "agentify-postgres",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/workspace/agentify/deploy/postgres-init",
          "target": "/docker-entrypoint-initdb.d",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "web": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.web"
      },
      "command": null,
      "depends_on": {
        "cabinet": {
          "condition": "service_healthy",
          "required": false
        },
        "gateway": {
          "condition": "service_healthy",
          "required": false
        }
      },
      "entrypoint": null,
      "environment": {
        "AGENTIFY_SITE_ADDRESS": "test.agentify.ad",
        "AGENTIFY_SURFACE_MODE": "test",
        "AGENTIFY_FRONT_PAGE": "scanner_front_page",
        "ADMIN_BASIC_AUTH_USER": "test-admin",
        "ADMIN_BASIC_AUTH_HASH": "$2a$14$offline-fixture-bcrypt-hash"
      },
      "image": "agentify-test-web:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "10.20.10.20",
          "target": 443,
          "published": "8443",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "agentify-caddy",
          "target": "/data",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "agentify-caddy": {
      "name": "agentify-test-caddy",
      "external": true
    },
    "agentify-postgres": {
      "name": "agentify-test-postgres",
      "external": true
    }
  },
  "x-app": {
    "build": {
      "context": ".",
      "dockerfile": "deploy/Dockerfile.app"
    },
    "image": "agentify-test-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "restart": "unless-stopped"
  }
}
