{
  "name": "agentify-commerce",
  "networks": {
    "agentify-ingress": {
      "name": "agentify-ingress",
      "ipam": {},
      "external": true
    },
    "default": {
      "name": "agentify-commerce_default",
      "ipam": {}
    }
  },
  "services": {
    "cabinet": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.app"
      },
      "command": [
        "pnpm",
        "--filter",
        "@agentify/cabinet",
        "start"
      ],
      "depends_on": {
        "gateway": {
          "condition": "service_started",
          "required": true
        },
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_SECRET": "fixture-auth-secret",
        "BASE_PATH": "/cabinet",
        "COOKIE_SECURE": "true",
        "DATABASE_URL": "postgres://agentify_commerce:synthetic-new-database-password@postgres:5432/agentify_commerce",
        "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "GATEWAY_URL": "http://gateway:3000",
        "MAIL_API_KEY": "re_synthetic-provider-key",
        "MAIL_FROM": "Agentify <no-reply@mail.example.com>",
        "MAIL_URL": "https://api.resend.com",
        "PAYMENT_NETWORK": "eip155:8453",
        "PORT": "3001",
        "PUBLIC_BASE_URL": "https://agentify.ad"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3001/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 15,
        "start_period": "15s"
      },
      "image": "agentify-commerce-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "gateway": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.app"
      },
      "command": [
        "pnpm",
        "--filter",
        "@agentify/gateway",
        "start"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "CDP_API_KEY_ID": "fixture-key-id",
        "CDP_API_KEY_SECRET": "fixture-key-secret",
        "DATABASE_URL": "postgres://agentify_commerce:synthetic-new-database-password@postgres:5432/agentify_commerce",
        "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "PAYMENT_NETWORK": "eip155:8453",
        "PAY_TO_ADDRESS": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
        "PORT": "3000",
        "PUBLIC_BASE_URL": "https://agentify.ad",
        "REGISTRATION_INVITATION": "fixture-invitation",
        "SANDBOX_MERCHANT_KEY": "csk_live_fixture-deployment-key"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 15,
        "start_period": "15s"
      },
      "image": "agentify-commerce-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "migrate": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.app"
      },
      "command": [
        "pnpm",
        "db:migrate"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "postgres://agentify_commerce:synthetic-new-database-password@postgres:5432/agentify_commerce"
      },
      "image": "agentify-commerce-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "postgres": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "agentify_commerce",
        "POSTGRES_PASSWORD": "synthetic-new-database-password",
        "POSTGRES_USER": "agentify_commerce"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U agentify_commerce -d agentify_commerce"
        ],
        "timeout": "3s",
        "interval": "2s",
        "retries": 15
      },
      "image": "postgres:17-alpine",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "agentify-postgres",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/workspace/agentify/deploy/postgres-init",
          "target": "/docker-entrypoint-initdb.d",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "web": {
      "build": {
        "context": "/workspace/agentify",
        "dockerfile": "deploy/Dockerfile.web"
      },
      "command": null,
      "depends_on": {
        "cabinet": {
          "condition": "service_healthy",
          "required": false
        },
        "gateway": {
          "condition": "service_healthy",
          "required": false
        }
      },
      "entrypoint": null,
      "environment": {
        "AGENTIFY_SITE_ADDRESS": ":8080",
        "AGENTIFY_SURFACE_MODE": "live",
        "AGENTIFY_TRUSTED_EDGE_CIDR": "172.30.80.2/32",
        "AGENTIFY_FRONT_PAGE": "scanner_front_page",
        "ADMIN_BASIC_AUTH_USER": "test-admin",
        "ADMIN_BASIC_AUTH_HASH": "$2a$14$offline-fixture-bcrypt-hash"
      },
      "image": "agentify-commerce-web:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "agentify-ingress": {
          "aliases": [
            "agentify-commerce-web"
          ]
        },
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "agentify-caddy",
          "target": "/data",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "agentify-caddy": {
      "name": "agentify-commerce-caddy",
      "external": true
    },
    "agentify-postgres": {
      "name": "agentify-commerce-postgres",
      "external": true
    }
  },
  "x-app": {
    "build": {
      "context": ".",
      "dockerfile": "deploy/Dockerfile.app"
    },
    "image": "agentify-commerce-app:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "restart": "unless-stopped"
  }
}
