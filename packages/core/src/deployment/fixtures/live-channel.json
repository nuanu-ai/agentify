{
  "name": "agentify",
  "networks": {
    "agentify-ingress": {
      "name": "agentify-ingress",
      "ipam": {},
      "external": true
    },
    "default": {
      "name": "agentify_default",
      "ipam": {}
    }
  },
  "services": {
    "app": {
      "command": [
        "pnpm",
        "--filter",
        "@agentify/app",
        "start"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_SECRET": "fixture-auth-secret",
        "BASE_PATH": "/dashboard",
        "CDP_API_KEY_ID": "fixture-key-id",
        "CDP_API_KEY_SECRET": "fixture-key-secret",
        "COOKIE_SECURE": "true",
        "DATABASE_URL": "postgres://agentify:synthetic-new-database-password@postgres:5432/agentify",
        "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "MAIL_API_KEY": "re_synthetic-provider-key",
        "MAIL_FROM": "Agentify <no-reply@mail.example.com>",
        "MAIL_URL": "https://api.resend.com",
        "PAYMENT_NETWORK": "eip155:8453",
        "PAY_TO_ADDRESS": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
        "PUBLIC_BASE_URL": "https://agentify.ad",
        "REPORT_IDENTITY_SECRET": "fixture-report-identity-secret-of-64-hexish-characters-0000000000",
        "SANDBOX_MERCHANT_KEY": ""
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "Promise.all(['http://127.0.0.1:3000/healthz','http://127.0.0.1:3001/healthz'].map(u=>fetch(u))).then(rs=>process.exit(rs.every(r=>r.ok)?0:1)).catch(()=>process.exit(1))"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 15,
        "start_period": "15s"
      },
      "image": "ghcr.io/nuanu-ai/agentify-app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "migrate": {
      "command": [
        "pnpm",
        "db:migrate"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "postgres://agentify:synthetic-new-database-password@postgres:5432/agentify"
      },
      "image": "ghcr.io/nuanu-ai/agentify-app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "postgres": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "agentify",
        "POSTGRES_PASSWORD": "synthetic-new-database-password",
        "POSTGRES_USER": "agentify"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U agentify -d agentify"
        ],
        "timeout": "3s",
        "interval": "2s",
        "retries": 15
      },
      "image": "docker.io/library/postgres@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "agentify-postgres",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/var/lib/agentify/production/postgres-init",
          "target": "/docker-entrypoint-initdb.d",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "scanner": {
      "command": null,
      "depends_on": {
        "app": {
          "condition": "service_started",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "scanner-migrate": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ABUSE_EMAIL": "abuse@agentify.ad",
        "ANALYTICS_RUNTIME_ENV": "production",
        "ANALYTICS_SERVER_DELIVERY_ENABLED": "false",
        "APIFY_BROWSER_MODE": "off",
        "APP_BASE_URL": "https://agentify.ad",
        "BENCHMARK_ENABLED": "false",
        "DASHBOARD_IDENTITY_URL": "http://app:3002",
        "CARD_SIGNAL_ENABLED": "false",
        "DATABASE_URL": "postgres://agentify:synthetic-new-database-password@postgres:5432/agentify",
        "EMAIL_ENCRYPTION_KEY": "ZmluZS1zeW50aGV0aWMtZml4dHVyZS1lbmNyeXB0aW9u",
        "LEGAL_IDENTITY_CONFIRMED": "false",
        "LEGAL_OPERATOR": "Operator identity pending confirmation",
        "META_DESTINATION_ENV": "production",
        "META_PIXEL_ID": "",
        "PARTNER_POSTBACK_ENABLED": "false",
        "POSTHOG_BROWSER_HOST": "",
        "POSTHOG_BROWSER_KEY": "",
        "POSTHOG_DESTINATION_ENV": "production",
        "PRIVACY_EMAIL": "privacy@agentify.ad",
        "PUBLIC_SHARE_ENABLED": "false",
        "REGISTRATION_ENABLED": "false",
        "REMEDIATION_PROMPT_ENABLED": "true",
        "REPORT_IDENTITY_SECRET": "fixture-report-identity-secret-of-64-hexish-characters-0000000000",
        "SCAN_ACCEPTANCE_ENABLED": "true",
        "STRIPE_PUBLISHABLE_KEY": "",
        "TOKEN_HMAC_SECRET": "fixture-token-hmac-secret-with-enough-characters",
        "TURNSTILE_ENFORCED": "false",
        "TURNSTILE_SECRET_KEY": "",
        "TURNSTILE_SITE_KEY": ""
      },
      "image": "ghcr.io/nuanu-ai/agentify-scanner@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "scanner-migrate": {
      "command": [
        "node",
        "packages/scanner-database/dist/migrate-cli.js"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "postgres://agentify:synthetic-new-database-password@postgres:5432/agentify"
      },
      "image": "ghcr.io/nuanu-ai/agentify-scanner-worker@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "scanner-privacy": {
      "profiles": [
        "jobs"
      ],
      "command": null,
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "APP_BASE_URL": "https://agentify.ad",
        "CARD_SIGNAL_ENABLED": "false",
        "DATABASE_URL": "postgres://agentify:synthetic-new-database-password@postgres:5432/agentify",
        "EMAIL_ENCRYPTION_KEY": "ZmluZS1zeW50aGV0aWMtZml4dHVyZS1lbmNyeXB0aW9u",
        "PRIVACY_CLEANUP_ACK": "yes",
        "PRIVACY_CLEANUP_BATCH_SIZE": "100",
        "PRIVACY_CLEANUP_DRY_RUN": "false",
        "REGISTRATION_ENABLED": "false",
        "STRIPE_ADAPTER": "local",
        "TOKEN_HMAC_SECRET": "fixture-token-hmac-secret-with-enough-characters"
      },
      "image": "ghcr.io/nuanu-ai/agentify-scanner-privacy@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "scanner-worker": {
      "command": null,
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "scanner-migrate": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ANALYTICS_ENV": "production",
        "ANALYTICS_RUNTIME_ENV": "production",
        "ANALYTICS_SERVER_DELIVERY_ENABLED": "false",
        "APIFY_API_TOKEN": "",
        "APIFY_BROWSER_ACTOR_BUILD": "",
        "APIFY_BROWSER_ACTOR_ID": "",
        "APIFY_BROWSER_CONCURRENCY": "1",
        "APIFY_BROWSER_DAILY_BUDGET_USD": "25",
        "APIFY_BROWSER_ENABLED": "false",
        "APIFY_BROWSER_MAX_PAGES": "3",
        "APIFY_BROWSER_MAX_RUN_USD": "0.05",
        "APIFY_BROWSER_MODE": "off",
        "APIFY_BROWSER_SAMPLE_RATE": "0.10",
        "APIFY_BROWSER_TIMEOUT_SECONDS": "60",
        "APP_BASE_URL": "https://agentify.ad",
        "DATABASE_URL": "postgres://agentify:synthetic-new-database-password@postgres:5432/agentify",
        "META_CAPI_ENABLED": "false",
        "META_DESTINATION_ENV": "production",
        "PARTNER_POSTBACK_ENABLED": "false",
        "PARTNER_POSTBACK_SECRET": "",
        "POSTHOG_DESTINATION_ENV": "production",
        "POSTHOG_ENABLED": "false",
        "SCANNER_CONCURRENCY": "4",
        "WORKER_ID": "agentify-production-1"
      },
      "image": "ghcr.io/nuanu-ai/agentify-scanner-worker@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "web": {
      "command": null,
      "depends_on": {
        "app": {
          "condition": "service_healthy",
          "required": false
        },
        "scanner": {
          "condition": "service_healthy",
          "required": false
        }
      },
      "entrypoint": null,
      "environment": {
        "AGENTIFY_FRONT_PAGE": "scanner_front_page",
        "AGENTIFY_SITE_ADDRESS": ":8080",
        "AGENTIFY_SURFACE_MODE": "live",
        "AGENTIFY_TRUSTED_EDGE_CIDR": "172.30.80.2/32"
      },
      "image": "ghcr.io/nuanu-ai/agentify-web@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "networks": {
        "agentify-ingress": {
          "aliases": [
            "agentify-web"
          ]
        },
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "agentify-caddy",
          "target": "/data",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "agentify-caddy": {
      "name": "agentify-caddy",
      "external": true
    },
    "agentify-postgres": {
      "name": "agentify-postgres",
      "external": true
    }
  },
  "x-app": {
    "build": {
      "context": ".",
      "dockerfile": "deploy/Dockerfile.app"
    },
    "image": "ghcr.io/nuanu-ai/agentify-app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "restart": "unless-stopped"
  },
  "x-scanner-app": {
    "build": {
      "context": ".",
      "dockerfile": "deploy/Dockerfile.scanner-worker"
    },
    "image": "ghcr.io/nuanu-ai/agentify-scanner-worker@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "restart": "unless-stopped"
  }
}
