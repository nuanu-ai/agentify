{
  "name": "@nuanu-ai/agentify",
  "version": "0.2.8",
  "type": "module",
  "description": "Sell your existing products to AI agents: publish product cards to an x402 storefront and fill the paid orders from your own service.",
  "keywords": [
    "x402",
    "agent-commerce",
    "ai-agents",
    "merchant-sdk",
    "stablecoin-payments",
    "usdc"
  ],
  "homepage": "https://agentify.ad/docs/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuanu-ai/agentify.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "agentify": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nuanu-ai/agentify-contracts": "workspace:*"
  },
  "devDependencies": {
    "@agentify/core": "workspace:*",
    "vitest": "^4.1.11"
  }
}
