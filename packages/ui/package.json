{
  "name": "@agentify/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The React components every surface on the origin draws with, thin wrappers over the classes of the shared visual language, and the server half that sends their built files",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets.ts",
    "./budget": "./src/budget.ts",
    "./chromium": "./src/chromium.ts",
    "./docs": "./src/docs.ts",
    "./surface": "./src/surface.ts",
    "./workspace": "./src/workspace.tsx",
    "./workspace-view": "./src/workspace-view.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/express": "^5.0.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "express": "5.2.1",
    "jsdom": "30.1.0",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.4.0",
    "vitest": "^4.1.11"
  }
}
