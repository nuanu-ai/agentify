{
  "name": "agentify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.21.x",
    "pnpm": "11.12.x"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check": "pnpm check:commerce && pnpm check:scanner",
    "check:commerce": "biome check .",
    "check:scanner": "pnpm scanner:format:check && pnpm scanner:lint",
    "check:fix": "biome check --write .",
    "check:decisions": "./scripts/check-decisions.sh",
    "db:migrate": "pnpm --filter @agentify/commerce-gateway db:migrate && pnpm --filter @agentify/commerce-cabinet db:migrate",
    "worktrees": "./scripts/worktrees.sh list",
    "worktrees:clean": "./scripts/worktrees.sh clean",
    "typecheck": "pnpm typecheck:commerce && pnpm typecheck:scanner",
    "typecheck:commerce": "tsc --noEmit -p tsconfig.json && pnpm --filter './packages/contracts' --filter './packages/core' --filter './packages/sdk' --filter './packages/slice' --filter './apps/cabinet' --filter './apps/gateway' --filter './apps/landing' --if-present run typecheck",
    "typecheck:scanner": "pnpm --filter './apps/web' --filter './apps/scanner-worker' --filter './apps/browser-observer-actor' --filter './packages/scanner-contracts' --filter './packages/scanner-database' --filter './packages/scanner' --filter './packages/analytics' --filter './packages/observability' --filter './packages/remediation' --recursive --if-present run typecheck",
    "build": "pnpm build:commerce && pnpm build:scanner && pnpm build:portal",
    "build:commerce": "pnpm --filter './packages/contracts' --filter './packages/core' --filter './packages/sdk' --filter './packages/slice' --filter './apps/cabinet' --filter './apps/gateway' --filter './apps/landing' --if-present run build",
    "build:scanner": "pnpm --filter './apps/web' --filter './apps/scanner-worker' --filter './apps/browser-observer-actor' --filter './packages/scanner-contracts' --filter './packages/scanner-database' --filter './packages/scanner' --filter './packages/analytics' --filter './packages/observability' --filter './packages/remediation' --recursive --if-present run build",
    "build:portal": "pnpm --filter @agentify/commerce-docs docs:build && node scripts/check-portal-render.mjs",
    "test": "pnpm test:commerce && pnpm test:scanner",
    "test:commerce": "vitest run",
    "test:scanner": "pnpm scanner:test:unit && pnpm scanner:ops:test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "smoke": "pnpm --filter @agentify/commerce-slice run smoke",
    "smoke:listing": "pnpm --filter @agentify/commerce-gateway run listing",
    "smoke:bootstrap": "pnpm --filter @agentify/commerce-slice run bootstrap",
    "outside": "./scripts/outside.sh",
    "approve": "node scripts/approve.mjs",
    "buy": "pnpm --filter @agentify/commerce-slice run buy",
    "stand": "pnpm --filter @agentify/commerce-slice run stand",
    "changeset": "changeset",
    "mutate": "node scripts/mutate.mjs",
    "scanner:check": "pnpm check:scanner && pnpm typecheck:scanner && pnpm test:scanner",
    "scanner:test:integration": "node ops/scripts/with-env.mjs pnpm run scanner:test:integration:inner",
    "scanner:test:actor": "pnpm --filter @agentify/browser-observer-actor test:integration",
    "scanner:test:db": "pnpm scanner:db:check && pnpm scanner:db:test:migrations",
    "scanner:build": "pnpm build:scanner",
    "scanner:self-readiness": "node ops/scripts/self-readiness-candidate.mjs",
    "scanner:db:up": "docker compose --env-file .env.scanner -f ops/compose.scanner.yaml up -d --wait postgres",
    "scanner:db:down": "docker compose --env-file .env.scanner -f ops/compose.scanner.yaml down",
    "scanner:db:migrate": "node ops/scripts/with-env.mjs pnpm --filter @agentify/scanner-database db:migrate",
    "scanner:dev": "node ops/scripts/with-env.mjs pnpm --parallel --filter @agentify/web --filter @agentify/scanner-worker dev",
    "scanner:test:integration:inner": "pnpm --filter @agentify/scanner-contracts build && pnpm --filter @agentify/analytics build && pnpm --filter @agentify/observability build && pnpm --filter @agentify/scanner build && pnpm --filter @agentify/web test:integration && pnpm --filter @agentify/web test:p5-integration",
    "scanner:clean": "pnpm --filter './apps/web' --filter './apps/scanner-worker' --filter './apps/browser-observer-actor' --filter './packages/scanner-contracts' --filter './packages/scanner-database' --filter './packages/scanner' --filter './packages/analytics' --filter './packages/observability' --filter './packages/remediation' --recursive --if-present run clean",
    "scanner:dev:web": "node ops/scripts/with-env.mjs pnpm --filter @agentify/web dev",
    "scanner:dev:worker": "node ops/scripts/with-env.mjs pnpm --filter @agentify/scanner-worker dev",
    "scanner:format": "prettier --write --config prettier.scanner.config.json --ignore-path .prettierignore.scanner \"{apps/web,apps/scanner-worker,apps/browser-observer-actor,packages/scanner-contracts,packages/scanner-database,packages/scanner,packages/analytics,packages/observability,packages/remediation}/**/*.{ts,tsx,json}\" \"tsconfig.scanner.json\" \"prettier.scanner.config.json\" \"ops/compose.scanner.yaml\" \"eslint.scanner.config.mjs\"",
    "scanner:format:check": "prettier --check --config prettier.scanner.config.json --ignore-path .prettierignore.scanner \"{apps/web,apps/scanner-worker,apps/browser-observer-actor,packages/scanner-contracts,packages/scanner-database,packages/scanner,packages/analytics,packages/observability,packages/remediation}/**/*.{ts,tsx,json}\" \"tsconfig.scanner.json\" \"prettier.scanner.config.json\" \"ops/compose.scanner.yaml\" \"eslint.scanner.config.mjs\"",
    "scanner:lint": "eslint --config eslint.scanner.config.mjs apps/web apps/scanner-worker apps/browser-observer-actor packages/scanner-contracts packages/scanner-database packages/scanner packages/analytics packages/observability packages/remediation --max-warnings=0",
    "scanner:test:unit": "pnpm --filter './packages/scanner-contracts' build && pnpm --filter './apps/web' --filter './apps/scanner-worker' --filter './apps/browser-observer-actor' --filter './packages/scanner-contracts' --filter './packages/scanner-database' --filter './packages/scanner' --filter './packages/analytics' --filter './packages/observability' --filter './packages/remediation' --recursive --if-present run test:unit",
    "scanner:db:generate": "pnpm --filter @agentify/scanner-database db:generate",
    "scanner:db:check": "pnpm --filter @agentify/scanner-database db:check",
    "scanner:db:test:migrations": "node ops/scripts/with-env.mjs pnpm --filter @agentify/scanner-database test:migrations",
    "scanner:ops:static": "bash ops/scripts/static-release-check.sh",
    "scanner:ops:runtime": "node ops/scripts/with-env.mjs bash ops/scripts/runtime-smoke.sh",
    "scanner:ops:browser": "node ops/scripts/with-env.mjs bash ops/scripts/browser-smoke.sh",
    "scanner:ops:load": "node ops/scripts/with-env.mjs node ops/scripts/load-scan.mjs",
    "scanner:ops:golden-corpus": "node ops/scripts/with-env.mjs node ops/scripts/golden-corpus.mjs",
    "scanner:ops:test": "node --test ops/scripts/*.test.mjs && python3 ops/deploy/test_agentify_test_woo_hairpin.py",
    "scanner:release:check": "node ops/scripts/with-env.mjs bash ops/scripts/release-gate.sh",
    "scanner:privacy:cleanup": "node ops/scripts/with-env.mjs bash ops/scripts/privacy-retention-cleanup.sh",
    "scanner:ops:local-core": "node ops/scripts/with-env.mjs bash ops/scripts/local-core-flow-smoke.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "^3.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.3.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "@eslint/js": "10.0.1",
    "axe-core": "4.12.1",
    "eslint": "10.0.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript-eslint": "8.63.0"
  }
}
