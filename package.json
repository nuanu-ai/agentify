{
  "name": "coinslot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.21.x",
    "pnpm": "11.12.x"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check": "pnpm check:commerce && pnpm check:agentify",
    "check:commerce": "biome check .",
    "check:agentify": "pnpm --dir agentify format:check && pnpm --dir agentify lint",
    "check:fix": "biome check --write .",
    "check:decisions": "./scripts/check-decisions.sh",
    "db:migrate": "pnpm --filter @coinslot/gateway db:migrate && pnpm --filter @coinslot/cabinet db:migrate",
    "worktrees": "./scripts/worktrees.sh list",
    "worktrees:clean": "./scripts/worktrees.sh clean",
    "typecheck": "pnpm typecheck:commerce && pnpm typecheck:agentify",
    "typecheck:commerce": "tsc --noEmit -p tsconfig.json && pnpm --filter './packages/*' --filter './apps/*' --if-present run typecheck",
    "typecheck:agentify": "pnpm --dir agentify typecheck",
    "build": "pnpm build:commerce && pnpm build:agentify && pnpm build:portal",
    "build:commerce": "pnpm --filter './packages/*' --filter './apps/*' --if-present run build",
    "build:agentify": "pnpm --dir agentify build",
    "build:portal": "pnpm --filter @coinslot/portal docs:build && node scripts/check-portal-render.mjs",
    "test": "pnpm test:commerce && pnpm test:agentify",
    "test:commerce": "vitest run",
    "test:agentify": "pnpm --dir agentify test:unit && pnpm --dir agentify ops:test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "smoke": "pnpm --filter @coinslot/slice run smoke",
    "smoke:listing": "pnpm --filter @coinslot/gateway run listing",
    "smoke:bootstrap": "pnpm --filter @coinslot/slice run bootstrap",
    "outside": "./scripts/outside.sh",
    "buy": "pnpm --filter @coinslot/slice run buy",
    "stand": "pnpm --filter @coinslot/slice run stand",
    "changeset": "changeset",
    "mutate": "node scripts/mutate.mjs",
    "agentify:check": "pnpm check:agentify && pnpm typecheck:agentify && pnpm test:agentify",
    "agentify:test:integration": "pnpm --dir agentify test:integration",
    "agentify:test:actor": "pnpm --filter @b2a/browser-observer-actor test:integration",
    "agentify:test:db": "pnpm --dir agentify db:check && pnpm --dir agentify db:test:migrations",
    "agentify:build": "pnpm build:agentify",
    "agentify:self-readiness": "pnpm --dir agentify self-readiness:candidate",
    "agentify:db:up": "cd agentify && docker compose up -d --wait postgres",
    "agentify:db:down": "cd agentify && docker compose down",
    "agentify:db:migrate": "cd agentify && corepack pnpm db:migrate",
    "agentify:dev": "cd agentify && corepack pnpm dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "^3.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.3.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
