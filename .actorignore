# The Actor CLI runs from the repository root so the shared lockfile is part of
# the uploaded Docker context. Keep the upload limited to the Actor build graph.
*
!/.actor/actor.json
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/.npmrc
!/tsconfig.scanner.json
!/packages/scanner-contracts/package.json
!/packages/scanner-contracts/tsconfig.json
!/packages/scanner-contracts/tsconfig.build.json
!/packages/scanner-contracts/src/*.ts
!/packages/scanner/package.json
!/packages/scanner/tsconfig.json
!/packages/scanner/tsconfig.build.json
!/packages/scanner/src/*.ts
!/apps/browser-observer-actor/.actor/input_schema.json
!/apps/browser-observer-actor/.actor/output_schema.json
!/apps/browser-observer-actor/ACTOR.md
!/apps/browser-observer-actor/Dockerfile
!/apps/browser-observer-actor/Dockerfile.dockerignore
!/apps/browser-observer-actor/package.json
!/apps/browser-observer-actor/tsconfig.json
!/apps/browser-observer-actor/tsconfig.build.json
!/apps/browser-observer-actor/fixtures/*.html
!/apps/browser-observer-actor/src/*.ts
