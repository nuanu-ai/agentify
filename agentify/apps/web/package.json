    "test:unit": "../../node_modules/.bin/vitest run --passWithNoTests --exclude lib/server/p4.integration.test.ts --exclude lib/server/p5.integration.test.ts --exclude lib/server/merchant-applications.integration.test.ts",
    "test:integration": "../../node_modules/.bin/vitest run lib/server/p4.integration.test.ts",
    "test:p5-integration": "../../node_modules/.bin/vitest run lib/server/p5.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "privacy:cleanup": "tsx scripts/privacy-cleanup.ts",
    "e2e:seed": "tsx scripts/seed-local-browser-evidence.ts",
    "test:merchant-integration": "../../node_modules/.bin/vitest run lib/server/merchant-applications.integration.test.ts"
  },
  "dependencies": {
    "@b2a/analytics": "workspace:*",
