  "scripts": {
    "prebuild": "pnpm --filter @b2a/contracts --filter @b2a/analytics --filter @b2a/db --filter @b2a/observability --filter @b2a/scanner-core --filter @b2a/remediation build",
    "build": "next build",
    "clean": "rm -rf .next",
    "predev": "pnpm --filter @b2a/contracts --filter @b2a/analytics --filter @b2a/db --filter @b2a/observability --filter @b2a/scanner-core --filter @b2a/remediation build",
    "dev": "next dev",
    "start": "next start",
