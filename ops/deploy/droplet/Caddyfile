(observability) {
	map {http.request.uri.path} {route_class} {
		~^/(store|local)?$ page_landing
		~^/(methodology|privacy|scanner|terms|data-request)$ page_trust
		~^/(robots\.txt|sitemap\.xml|llms\.txt)$ public_agent_surface
		~^/admin(?:/.*)?$ page_admin
		~^/scan/pending$ page_scan_pending
		~^/scan/[^/]+$ page_scan
		~^/report/[^/]+$ page_report
		~^/s/[^/]+$ page_share
		~^/(auth/callback|email/unsubscribe|verification/error)$ page_account_flow
		~^/api/health$ api_health
		~^/api/health/live$ api_health_live
		~^/api/v1/scans$ api_v1_scans_create
		~^/api/v1/scans/[^/]+/status$ api_v1_scan_status
		~^/api/v1/scans/[^/]+/.*$ api_v1_scan_action
		~^/api/v1/reports/[^/]+(?:/.*)?$ api_v1_report
		~^/api/v1/shares/[^/]+$ api_v1_share
		~^/api/v1/waitlist/[^/]+/answer$ api_v1_waitlist
		~^/api/v1/card-signals(?:/.*)?$ api_v1_card_signal
		~^/api/v1/(attribution|consent|events)$ api_v1_analytics
		~^/api/v1/account/.*$ api_v1_account
		~^/api/v1/auth/verify$ api_v1_auth
		~^/api/v1/webhooks/stripe$ api_v1_stripe_webhook
		~^/api/v2/auth/finalize$ api_v2_auth
		~^/api/v2/scans/[^/]+/.*$ api_v2_scan_action
		~^/_next/ asset_next
		default other
	}

	log {
		output stdout
		format filter {
			request>remote_ip delete
			request>client_ip delete
			request>remote_port delete
			request>uri delete
			request>headers delete
			resp_headers delete
			user_id delete
			wrap json
		}
	}

	log_append service caddy
	log_append request_id {http.request.uuid}
	log_append route {route_class}
	request_header X-Request-Id {http.request.uuid}
	header >X-Request-Id {http.request.uuid}
}

agentify.ad {
	import observability
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		-Server
	}

	@admin path /admin /admin/*
	handle @admin {
		basic_auth {
			{$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
		}
		header {
			Cache-Control "private, no-store"
			X-Robots-Tag "noindex, nofollow"
			Referrer-Policy "no-referrer"
		}
		reverse_proxy web:3000
	}

	handle {
		reverse_proxy web:3000
	}
}

www.agentify.ad {
	import observability
	redir https://agentify.ad{uri} permanent
}
