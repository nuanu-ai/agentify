/var/lib/docker/containers/*/*.log {
  su root root
  daily
  rotate 14
  compress
  delaycompress
  copytruncate
  missingok
  notifempty
}

/var/log/agentify-backup.log /var/log/agentify-privacy-cleanup.log {
  su root root
  daily
  rotate 14
  compress
  delaycompress
  copytruncate
  missingok
  notifempty
}
