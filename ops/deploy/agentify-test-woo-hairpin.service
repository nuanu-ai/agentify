[Unit]
Description=Agentify TEST Woo public-address hairpin
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionHost=dmitry-dev

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/agentify-test-woo-hairpin reconcile
ExecReload=/usr/local/libexec/agentify-test-woo-hairpin reconcile
ExecStop=/usr/local/libexec/agentify-test-woo-hairpin remove
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
