{
  "name": "@agentify/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agentify seller dashboard — cards, orders and receipts, server-rendered",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./start": "./src/start.ts"
  },
  "scripts": {
    "build": "react-router build && tsx src/precompress.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "account": "tsx src/account.ts",
    "approve": "tsx src/approve.ts",
    "forget": "tsx src/forget.ts",
    "woo:recover": "tsx src/woo-recover.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@agentify/core": "workspace:*",
    "@agentify/gateway": "workspace:*",
    "@agentify/scanner-contracts": "workspace:*",
    "@agentify/ui": "workspace:*",
    "@agentify/visual": "workspace:*",
    "@nuanu-ai/agentify-contracts": "workspace:*",
    "@react-router/express": "7.18.4",
    "@react-router/node": "7.18.4",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "entities": "8.1.0",
    "express": "5.2.1",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@testing-library/react": "16.3.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.1.0",
    "tsx": "^4.23.12",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
