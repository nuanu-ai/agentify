{
  "name": "@agentify/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @agentify/scanner-contracts --filter @agentify/analytics --filter @agentify/scanner-database --filter @agentify/observability --filter @agentify/scanner --filter @agentify/remediation build",
    "build": "react-router build && tsx server/precompress.ts",
    "budget": "tsx server/budget.ts",
    "clean": "rm -rf dist .react-router",
    "predev": "pnpm --filter @agentify/scanner-contracts --filter @agentify/analytics --filter @agentify/scanner-database --filter @agentify/observability --filter @agentify/scanner --filter @agentify/remediation build",
    "dev": "tsx server/dev.ts",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "privacy:cleanup": "tsx scripts/privacy-cleanup.ts",
    "e2e:seed": "tsx scripts/seed-local-browser-evidence.ts"
  },
  "dependencies": {
    "@agentify/analytics": "workspace:*",
    "@agentify/observability": "workspace:*",
    "@agentify/remediation": "workspace:*",
    "@agentify/scanner": "workspace:*",
    "@agentify/scanner-contracts": "workspace:*",
    "@agentify/scanner-database": "workspace:*",
    "@agentify/ui": "workspace:*",
    "@agentify/visual": "workspace:*",
    "@fontsource-variable/schibsted-grotesk": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/noto-sans-symbols": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.2.8",
    "@react-router/express": "8.4.0",
    "@react-router/node": "8.4.0",
    "@resvg/resvg-wasm": "2.4.0",
    "@stripe/react-stripe-js": "6.7.0",
    "@stripe/stripe-js": "9.9.0",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "pg-boss": "12.28.0",
    "posthog-js": "1.399.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.4.0",
    "satori": "0.25.0",
    "stripe": "22.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agentify/gallery": "workspace:*",
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.1.0",
    "playwright": "1.61.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
