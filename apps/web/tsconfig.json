{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite compiles this app for the browser and for the server: modules
    // resolve the way a bundler resolves them, and the browser's names and
    // Vite's own (a stylesheet's classes, `import.meta.env`) are in scope.
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
