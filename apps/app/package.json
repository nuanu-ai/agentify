{
  "name": "@agentify/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agentify application — the gateway and the dashboard in one process",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
